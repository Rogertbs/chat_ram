# Proxy LiteLLM fornecido ao projeto (não versionar valores reais)
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=sk-troque-me
MODEL_ALIAS=qwen-local

# PostgreSQL 18 (cópia fixa do OTRS; ver docs/postgres18.md)
POSTGRES18_HOST=127.0.0.1
POSTGRES18_PORT=5435
POSTGRES18_DB=otrs
POSTGRES18_USER=otrs
POSTGRES18_PASSWORD=troque-me

# Desenvolvimento com banco mock (ver docs/mock.md):
#   python mock/gerar_banco.py --recriar
#   POSTGRES18_DB=otrs_mock
#
# Exemplo de proxy externo para desenvolvimento com o mock (OpenRouter):
#   LITELLM_BASE_URL=https://openrouter.ai/api   # base sem /v1; o adapter acrescenta
#   LITELLM_API_KEY=sk-or-v1-...
#   MODEL_ALIAS=nvidia/nemotron-3-super-120b-a12b:free
#   EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
#   EMBEDDING_DIMENSION=1024
#   EMBEDDING_TRUNCATE_TO=1024   # MRL local: corta o 2048 do modelo para 1024

# Preparação do histórico
RAG_SCHEMA=rag
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
# EMBEDDING_TRUNCATE_TO=1024   # só para modelos com MRL (corte local + renormalização)
EMBEDDING_BATCH=64
TRECHO_MAX_CHARS=2000
TRECHO_OVERLAP_CHARS=200
PROCESSING_VERSION=1
