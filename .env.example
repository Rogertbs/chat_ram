# Proxy LiteLLM fornecido ao projeto (não versionar valores reais)
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=sk-troque-me
MODEL_ALIAS=qwen-local

# PostgreSQL 18 (cópia fixa do OTRS; ver docs/postgres18.md)
POSTGRES18_HOST=127.0.0.1
POSTGRES18_PORT=5435
POSTGRES18_DB=otrs
POSTGRES18_USER=otrs
POSTGRES18_PASSWORD=troque-me

# Preparação do histórico
RAG_SCHEMA=rag
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH=64
TRECHO_MAX_CHARS=2000
TRECHO_OVERLAP_CHARS=200
PROCESSING_VERSION=1
